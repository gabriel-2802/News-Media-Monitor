{
  "info": {
    "name": "News Provider API",
    "description": "Endpoints for the news_monitor_v2 provider service: registering news sources and ingesting/querying scraped articles.\n\nRun the 'News Sources > Add News Source' and 'Articles > Save Article' requests first (or the whole collection top-to-bottom) — later requests use collection variables ({{sourceName}}, {{articleUrl}}) populated by their test scripts.\n\nNote: baseUrl/rssUrl in 'Add News Source' must be real, HEAD-reachable URLs (the service pings them server-side before saving) — swap in a real source's URLs if example.com stops working for you.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "sourceName", "value": "example-news", "type": "string" },
    { "key": "articleUrl", "value": "https://example.com/news/senate-passes-budget", "type": "string" }
  ],
  "item": [
    {
      "name": "News Sources",
      "item": [
        {
          "name": "List News Sources",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/news-sources?page=0&count=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "count", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => Array.isArray(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add News Source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/news-sources",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{sourceName}}\",\n  \"baseUrl\": \"https://example.com\",\n  \"rssUrl\": \"https://example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns saved source name', () => pm.expect(body.name).to.eql(pm.collectionVariables.get('sourceName')));",
                  "if (body.name) pm.collectionVariables.set('sourceName', body.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add News Source - Duplicate Name (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/news-sources",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{sourceName}}\",\n  \"baseUrl\": \"https://example.com\",\n  \"rssUrl\": \"https://example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions existing name', () => pm.expect(pm.response.json().message).to.include('already exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add News Source - Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/news-sources",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"baseUrl\": \"\",\n  \"rssUrl\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Details include field errors', () => {",
                  "  const details = pm.response.json().details;",
                  "  pm.expect(details).to.have.property('name');",
                  "  pm.expect(details).to.have.property('baseUrl');",
                  "  pm.expect(details).to.have.property('rssUrl');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Increment Failure Count",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/news-sources/{{sourceName}}/failure",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources", "{{sourceName}}", "failure"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Failure count incremented to at least 1', () => pm.expect(pm.response.json().failureCount).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Increment Failure Count - Unknown Source (400)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/news-sources/does-not-exist/failure",
              "host": ["{{baseUrl}}"],
              "path": ["api", "news-sources", "does-not-exist", "failure"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions missing source', () => pm.expect(pm.response.json().message).to.include('does not exist'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "List Articles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles?page=0&count=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "count", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => Array.isArray(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Articles By Source",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/source/{{sourceName}}?page=0&count=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "source", "{{sourceName}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "count", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => Array.isArray(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Article",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Jane Doe\",\n  \"title\": \"Senate passes new budget bill\",\n  \"url\": \"{{articleUrl}}\",\n  \"bodyText\": \"Full article text goes here.\",\n  \"publishedAt\": \"2026-07-01T14:30:00\",\n  \"sourceName\": \"{{sourceName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns saved article url', () => pm.expect(body.url).to.eql(pm.collectionVariables.get('articleUrl')));",
                  "if (body.url) pm.collectionVariables.set('articleUrl', body.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Article - Duplicate URL (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Jane Doe\",\n  \"title\": \"Senate passes new budget bill\",\n  \"url\": \"{{articleUrl}}\",\n  \"bodyText\": \"Full article text goes here.\",\n  \"publishedAt\": \"2026-07-01T14:30:00\",\n  \"sourceName\": \"{{sourceName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions existing article', () => pm.expect(pm.response.json().message).to.include('already exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Article - Unknown Source (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Jane Doe\",\n  \"title\": \"Untitled\",\n  \"url\": \"https://example.com/news/unknown-source-article\",\n  \"bodyText\": \"Full article text goes here.\",\n  \"publishedAt\": \"2026-07-01T14:30:00\",\n  \"sourceName\": \"does-not-exist\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions missing source', () => pm.expect(pm.response.json().message).to.include('does not exist'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Article - URL/Source Mismatch (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Jane Doe\",\n  \"title\": \"Untitled\",\n  \"url\": \"https://a-completely-different-domain.test/news/x\",\n  \"bodyText\": \"Full article text goes here.\",\n  \"publishedAt\": \"2026-07-01T14:30:00\",\n  \"sourceName\": \"{{sourceName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions URL/source mismatch', () => pm.expect(pm.response.json().message).to.include('is not from source'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Article - Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Jane Doe\",\n  \"title\": \"\",\n  \"url\": \"\",\n  \"bodyText\": \"\",\n  \"publishedAt\": null,\n  \"sourceName\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Details include field errors', () => {",
                  "  const details = pm.response.json().details;",
                  "  pm.expect(details).to.have.property('title');",
                  "  pm.expect(details).to.have.property('url');",
                  "  pm.expect(details).to.have.property('bodyText');",
                  "  pm.expect(details).to.have.property('sourceName');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Article Exists - True",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/exists?url={{articleUrl}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "exists"],
              "query": [{ "key": "url", "value": "{{articleUrl}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Article exists', () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Article Exists - False",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/exists?url=https://example.com/news/never-saved",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "exists"],
              "query": [{ "key": "url", "value": "https://example.com/news/never-saved" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Article does not exist', () => pm.expect(pm.response.json()).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
